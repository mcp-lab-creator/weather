# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# Server-only secret key ("service_role" or "secret" key). NEVER share or expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Single password for /admin (use something long)
ADMIN_PASSWORD=

# WhatsApp number with country code, digits only (e.g. 919876543210). Leave empty to hide the button.
NEXT_PUBLIC_WHATSAPP_NUMBER=
